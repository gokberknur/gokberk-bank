# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local-only reference clones for skills (e.g. plotly.js source for charting lookup) — never committed
.claude/gitrepos/

# Local-only planning system (specs, backlog, UX flows, ADRs) — never committed
.planning/

# Local-only execution artefacts for the current spec (plan + task list) — never committed
tasks/

# Local-only QA/UX assessment findings (working notes + screenshots) — never committed.
# The E2E specs that come out of an assessment ARE committed, under e2e/.
assessmentv1/

# Local-only UI/visual-design assessment findings (working notes + screenshots) — never committed.
assessment-ui/

# Playwright artifacts
/test-results/
/playwright-report/
/playwright/.cache/
# playwright-cli session profiles / browser cache (created when driving the CLI)
/.playwright-cli/
